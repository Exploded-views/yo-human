{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Exploded-views/yo-human/config.schema.json",
  "title": "yo-human config",
  "description": "One config file. Layers merge with the closest winning; no file holds a secret value.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" } }
    },
    "deadline": { "type": "string", "description": "Go duration, for example 1s" },
    "incident_ttl": { "type": "string", "description": "Go duration, for example 24h" },
    "channels": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": { "type": { "type": "string", "minLength": 1 } }
      }
    },
    "levels": {
      "type": "array",
      "description": "Quietest first. The closest file that defines levels replaces the ladder whole.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
          "use_when": { "type": "string" },
          "ask": { "enum": ["required", "optional"] },
          "quiet_hours": { "enum": ["hold", "send"] },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "every": { "type": "string" },
              "times": { "type": "integer", "minimum": 0 }
            }
          },
          "reminder": { "type": "string" },
          "send": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["channel", "interruption"],
              "additionalProperties": false,
              "properties": {
                "channel": { "type": "string", "minLength": 1 },
                "interruption": { "enum": ["passive", "active", "time-sensitive", "critical"] },
                "options": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "quiet_hours": {
      "type": "object",
      "required": ["timezone", "windows"],
      "additionalProperties": false,
      "properties": {
        "timezone": { "type": "string", "minLength": 1, "description": "IANA zone name" },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["days", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "days": {
                "type": "array",
                "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
              },
              "from": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "to": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
            }
          }
        }
      }
    },
    "shim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/shimMode" },
        "low": { "$ref": "#/$defs/shimMode" },
        "agent": { "type": "string" }
      }
    }
  },
  "$defs": {
    "shimMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "level": { "type": "string" }, "ask": { "type": "string" } }
    }
  }
}
